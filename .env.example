# InterviewMate AI — environment template (placeholders only; never commit real keys)
IM_SECRET_KEY=change-me-to-a-long-random-string
IM_DB_PATH=./interviewmate.db
IM_HOST=127.0.0.1
IM_PORT=8000
IM_MAX_UPLOAD_MB=5
IM_RATE_LIMIT_PER_MIN=120

# LLM provider: "offline" (default, deterministic heuristics, no network) or "openai_compatible"
IM_LLM_PROVIDER=offline
IM_LLM_BASE_URL=https://api.example.com/v1
IM_LLM_API_KEY=
IM_LLM_MODEL=

# Speech (optional). Leave empty to use the typed-answer fallback.
IM_STT_BASE_URL=
IM_STT_API_KEY=
IM_STT_MODEL=whisper-1
IM_TTS_BASE_URL=
IM_TTS_API_KEY=
IM_TTS_MODEL=
